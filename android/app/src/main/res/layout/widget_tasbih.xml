<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/tz_open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📿 المسبحة" android:textColor="#E8BE5C" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tz_next" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/wg_round" android:gravity="center" android:text="⇄" android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>

    <TextView android:id="@+id/tz_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="سبحان الله وبحمده" android:textColor="#FFFFFF" android:textSize="12.5sp" android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/tz_tap"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/wg_tap"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/tz_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:text="٣٣" android:textColor="#3A2600" android:textSize="24sp" />
            <TextView android:id="@+id/tz_goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="من ١٠٠" android:textColor="#7A5410" android:textSize="9.5sp" />
        </LinearLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/tz_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:max="100"
        android:progress="33"
        android:progressDrawable="@drawable/wg_bar" />
</LinearLayout>
